            "header": [],
            "description": "Expected: 200 OK with the paginated customer response. Optional filters are name, email, phone, page, and pageSize.",
            "url": {
              "raw": "{{baseUrl}}/customers?name=Abhishek&page=1&pageSize=5",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [
                {"key": "name", "value": "Abhishek"},
                {"key": "page", "value": "1"},
                {"key": "pageSize", "value": "5"}
              ]
            }
          }
        },
