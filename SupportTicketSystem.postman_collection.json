          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "description": "Expected: 201 Created. Missing required fields or a duplicate email return 400 or another API error response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Customer\",\n  \"email\": \"new.customer@example.com\",\n  \"phone\": \"+1-555-0100\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Update customer",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "description": "Expected: 200 OK. An unknown customer returns 404 Not Found or the API error response.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Customer\",\n  \"email\": \"updated.customer@example.com\",\n  \"phone\": \"+1-555-0101\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            }
          }
        },
        {
          "name": "Delete customer",
          "request": {
            "method": "DELETE",
            "header": [],
            "description": "Expected: 200 OK when the customer has no open tickets. A customer with open tickets should be rejected with the API error response, normally 400; an unknown customer returns 404.",
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["customers", "{{customerId}}"]
            }
          }
        }
      ]
